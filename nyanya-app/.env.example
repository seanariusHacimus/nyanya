##
## nyanya-app — переменные окружения.
## Скопируйте в .env и заполните: cp .env.example .env
## Пометка [prod] — задаётся в Railway, локально не нужна.
##

## ─────────────────────────── База данных ───────────────────────────
# Локально поднимается docker compose из корня репозитория (порт 5434).
DATABASE_URL=postgresql://nyanya:nyanya_dev@localhost:5434/nyanya

# [prod] Публичный адрес БД через TCP-прокси Railway. Нужен только скриптам,
# которые ходят в прод-базу снаружи; само приложение использует DATABASE_URL.
# DATABASE_PUBLIC_URL=

## ──────────────────────── Аутентификация ────────────────────────
# Секрет подписи сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Значение должно быть случайным — плейсхолдер здесь равен отсутствию защиты.
BETTER_AUTH_SECRET=

# Внешний адрес приложения (без слэша на конце).
BETTER_AUTH_URL=http://localhost:3000

# Внешний адрес для ссылок в письмах, robots.txt и sitemap.xml (без слэша на
# конце). Без переменной подставляется https://www.nyanya.uz. Префикс NEXT_PUBLIC_
# означает, что значение вшивается при сборке — задавать до `npm run build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

## ──────────────────────────── Почта ────────────────────────────
# Без RESEND_API_KEY письма не отправляются, а код печатается в консоль
# сервера — этого достаточно для локальной разработки.
# RESEND_API_KEY=

# Отправитель. Домен должен быть подтверждён в Resend, иначе письма уходят
# от общего onboarding@resend.dev, который Resend разрешает слать только
# владельцу аккаунта.
# EMAIL_FROM=NYANYA.UZ <noreply@nyanya.uz>

## ──────────────── Лимиты на открытие контактов ────────────────
# Открытие контактов бесплатное, но не безлимитное (src/lib/unlock-limits.ts).
# Уже открытый контакт не считается и не блокируется; администратор лимитом
# не ограничен. Без переменных действуют значения по умолчанию, указанные ниже.
#
# Сколько НОВЫХ контактов аккаунт может открыть за скользящие 24 часа.
# Целое число от 1; пустое значение, 0 или не число — берётся 20.
# Аккаунт, исчерпавший лимит, отмечается для разбора на обзоре админки.
# CONTACT_UNLOCK_DAILY_CAP=20
#
# Минимальная пауза между двумя новыми открытиями, секунд. Целое число от 0
# (0 — без паузы); не число — берётся 3. Верхней границы нет: опечатка вроде
# 3600 разрешит каждому аккаунту одно новое открытие в час. Даже при 0 запрос,
# пришедший одновременно с другим запросом того же аккаунта, получает отказ
# «через 1 с» — так пачка запросов одного аккаунта не занимает пул соединений.
# CONTACT_UNLOCK_MIN_INTERVAL_SEC=3

## ────────────────── Хранилище документов верификации ──────────────────
# local — файлы в .storage/ (по умолчанию, если ключи S3 не заданы)
# s3    — S3-совместимый бакет (Railway object storage)
STORAGE_PROVIDER=local

# Каталог для провайдера local.
# STORAGE_DIR=.storage/documents

# [prod] Выдаются командой: railway bucket credentials --bucket <имя>
# AWS_ENDPOINT_URL=
# AWS_S3_BUCKET_NAME=
# AWS_DEFAULT_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Явные переопределения, если имена AWS_* заняты чем-то другим.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_URL_STYLE=virtual-host   # path — для MinIO и локальных эмуляторов

## ───────────────── Уведомления о заявках с сайта ─────────────────
# Форма обратной связи шлёт сообщение в Telegram. Без токена отправка
# пропускается, заявка всё равно не теряется.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
