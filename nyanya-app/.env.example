##
## nyanya-app — переменные окружения.
## Скопируйте в .env и заполните: cp .env.example .env
## Пометка [prod] — задаётся в Railway, локально не нужна.
##

## ─────────────────────────── База данных ───────────────────────────
# Локально поднимается docker compose из корня репозитория (порт 5434).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/nyanya

# [prod] Публичный адрес БД через TCP-прокси Railway. Нужен только скриптам,
# которые ходят в прод-базу снаружи; само приложение использует DATABASE_URL.
# DATABASE_PUBLIC_URL=

## ──────────────────────── Аутентификация ────────────────────────
# Секрет подписи сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Значение должно быть случайным — плейсхолдер здесь равен отсутствию защиты.
BETTER_AUTH_SECRET=

# Внешний адрес приложения (без слэша на конце).
BETTER_AUTH_URL=http://localhost:3000

## ──────────────────────────── Почта ────────────────────────────
# Без RESEND_API_KEY письма не отправляются, а код печатается в консоль
# сервера — этого достаточно для локальной разработки.
# RESEND_API_KEY=

# Отправитель. Домен должен быть подтверждён в Resend, иначе письма уходят
# от общего onboarding@resend.dev, который Resend разрешает слать только
# владельцу аккаунта.
# EMAIL_FROM=NYANYA.UZ <noreply@nyanya.uz>

## ────────────────── Хранилище документов верификации ──────────────────
# local — файлы в .storage/ (по умолчанию, если ключи S3 не заданы)
# s3    — S3-совместимый бакет (Railway object storage)
STORAGE_PROVIDER=local

# Каталог для провайдера local.
# STORAGE_DIR=.storage/documents

# --- SMS (Eskiz.uz) ---------------------------------------------------------
# eskiz — настоящая отправка, mock — код печатается в лог сервера.
# По умолчанию: eskiz, если заданы ключи ниже, иначе mock.
# SMS_PROVIDER=mock

# Оба значения берутся в кабинете Eskiz: Смс → Смс шлюз
# (https://my.eskiz.uz/sms/settings).
# ВНИМАНИЕ: ESKIZ_SECRET — это «секретный ключ», а НЕ пароль от кабинета.
# С паролем от кабинета шлюз отвечает invalid_credentials.
# ESKIZ_EMAIL=you@example.com
# ESKIZ_SECRET=

# Подпись отправителя (альфа-имя). Пока оно не одобрено — оставить пустым:
# SMS уходят с короткого номера Eskiz.
# ESKIZ_FROM=

# Подменить текст на «Это тест от Eskiz» — единственный, который Eskiz
# разрешает, пока аккаунт в тестовом статусе. Нужно ровно для первой проверки.
# ESKIZ_FORCE_TEST_TEXT=1

# Открыть служебную страницу /sms-test в продакшене (по умолчанию её там нет).
# Только для разовой проверки, потом убрать.
# SMS_TEST_PAGE=1

# [prod] Выдаются командой: railway bucket credentials --bucket <имя>
# AWS_ENDPOINT_URL=
# AWS_S3_BUCKET_NAME=
# AWS_DEFAULT_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Явные переопределения, если имена AWS_* заняты чем-то другим.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_URL_STYLE=virtual-host   # path — для MinIO и локальных эмуляторов

## ───────────────── Уведомления о заявках с сайта ─────────────────
# Форма обратной связи шлёт сообщение в Telegram. Без токена отправка
# пропускается, заявка всё равно не теряется.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
