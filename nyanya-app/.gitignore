# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...кроме шаблона: он документирует обязательные переменные и секретов не содержит
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# дампы служебных скриптов (delete-accounts пишет delete-backup-*.json) и списки ключей
# хранилища — содержат персональные данные, в репозиторий не попадают
*-backup-*.json
purge-orphan-keys.txt
# backfill-photos.mjs дописывает сюда ключи заменённых оригиналов — список для
# последующей чистки через purge-orphan-files.mjs, не часть кода
backfill-photos-originals.txt
